{
  "name": "electron-desktop-hud",
  "version": "0.1.0",
  "description": "Translucent desktop HUD overlay — subtitle-like text rendered via Electron/Chromium, driven by UDP",
  "main": "dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "start": "pnpm run build && electron .",
    "dev": "pnpm run build && electron . --inspect",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^34.0.0",
    "esbuild": "^0.27.4",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  }
}
